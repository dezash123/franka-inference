[Unit]
Description=Stable network address for the directly connected Franka FR3
After=NetworkManager.service
Requires=NetworkManager.service
RequiresMountsFor=/var/lib/spring-data
[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/franka/c2-dhcp.conf --pid-file=
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
