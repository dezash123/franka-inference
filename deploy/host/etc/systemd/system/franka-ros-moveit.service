[Unit]
Description=MoveIt planning for Rome's Franka FR3 v2.1
After=franka-ros-state.service
Requires=franka-ros-state.service
[Service]
Type=simple
User=spring
WorkingDirectory=/var/lib/spring-data/franka-network-20260923/ros
ExecStart=/var/lib/spring-data/franka-network-20260923/ros/start-ros-moveit.sh
KillSignal=SIGINT
TimeoutStopSec=10
Restart=no
StandardOutput=append:/var/lib/spring-data/franka-network-20260923/ros/moveit.log
StandardError=append:/var/lib/spring-data/franka-network-20260923/ros/moveit.log
[Install]
WantedBy=multi-user.target
